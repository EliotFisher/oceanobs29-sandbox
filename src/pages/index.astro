---
// Homepage copy and media are read from the shared configuration.
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import SectionHead from '~/components/site/SectionHead.astro';
import UpcomingEvents from '~/components/site/UpcomingEvents.astro';

import { SITE, I18N } from 'astrowind:config';
import { ORG } from '~/config/org';
import { HOME } from '~/config/home';
import Image from '~/components/common/Image.astro';
import PhotoCredit from '~/components/site/PhotoCredit.astro';
import { HERO_VIDEO, IMAGES } from '~/config/images';
import { getImage } from 'astro:assets';
import { getPermalink } from '~/utils/permalinks';
import { getEvents, splitByTime } from '~/utils/events';

const metadata = { title: `${ORG.name}: Shaping the next decade of global ocean observing`, ignoreTitleTemplate: true };

const { upcoming } = splitByTime(await getEvents());
const linkClass = 'inline-flex items-center gap-1.5 font-semibold text-link underline-offset-4 hover:underline';
const heroPoster = await getImage({ src: HERO_VIDEO.poster, width: 1920, format: 'webp' });

// Structured data built only from config.yaml and src/config/org.ts: keep it true.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: ORG.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <section class="home-hero" style={`--hero-poster: url("${heroPoster.src}")`} aria-labelledby="hero-heading">
    <video
      class="home-hero__video"
      poster={heroPoster.src}
      muted
      playsinline
      preload="none"
      tabindex="-1"
      aria-hidden="true"
      data-hero-video
    >
      <source src={HERO_VIDEO.src} type={HERO_VIDEO.type} />
    </video>
    <div class="home-hero__copy mx-auto w-full max-w-7xl px-4 lg:px-6">
      <p class="home-hero__location">{HOME.hero.locationDate}</p>
      <h1 id="hero-heading">{HOME.hero.headlineLead} {HOME.hero.headlineEmphasis}</h1>
      <p class="mt-6 max-w-xl text-lg text-on-dark md:text-xl">{HOME.hero.intro}</p>
      <div class="home-actions mt-8 flex flex-wrap gap-3">
        <a href={getPermalink(HOME.hero.primary.href)} class="btn-site-outline-light home-hero__primary">
          {HOME.hero.primary.text}
          <Icon name="tabler:arrow-up-right" class="size-4" aria-hidden="true" />
        </a>
        <a href={getPermalink(HOME.hero.secondary.href)} class="btn-site-outline-light">
          {HOME.hero.secondary.text}
          <Icon name="tabler:arrow-up-right" class="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>
    <button type="button" class="home-hero__control" aria-label="Play background video" data-hero-video-toggle hidden>
      <Icon name="tabler:player-play" class="size-5" aria-hidden="true" data-play-icon />
      <Icon name="tabler:player-pause" class="size-5" aria-hidden="true" data-pause-icon />
    </button>
  </section>

  <script>
    function setupHeroVideo() {
      const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
      const button = document.querySelector<HTMLButtonElement>('[data-hero-video-toggle]');
      if (!video || !button || video.dataset.ready) return;
      video.dataset.ready = 'true';
      video.muted = true;

      const update = () => {
        const playing = !video.paused && !video.ended;
        const label = playing
          ? 'Pause background video'
          : video.ended
            ? 'Replay background video'
            : 'Play background video';
        button.toggleAttribute('data-playing', playing);
        button.setAttribute('aria-label', label);
        button.title = label;
      };

      const play = () => {
        void video.play().catch(() => update());
      };

      video.addEventListener('play', update);
      video.addEventListener('playing', () => video.setAttribute('data-show-frame', ''));
      video.addEventListener('pause', update);
      const showPoster = () => {
        video.removeAttribute('data-show-frame');
        update();
      };
      video.addEventListener('ended', showPoster);
      video.addEventListener('error', showPoster);
      button.addEventListener('click', () => {
        if (video.paused) play();
        else video.pause();
      });

      document.addEventListener('astro:before-swap', () => video.pause(), { once: true });
      button.hidden = false;
      update();

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
      if (!reduceMotion && !saveData) play();
    }

    document.addEventListener('astro:page-load', setupHeroVideo);
  </script>

  <!-- 2. About OceanObs, in three short sections. Words in src/config/home.ts. -->
  <section class="home-paper py-16 md:py-24" aria-labelledby="about-oceanobs">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <div class="grid items-stretch gap-8 lg:grid-cols-12 lg:gap-14">
        <div class="intersect intersect-once py-2 lg:col-span-6 lg:py-8" data-motion-reveal>
          <h2 id="about-oceanobs" class="scroll-mt-28 text-heading">
            <span class="eyebrow block text-link">{HOME.about.titleLead}</span>
            <span class="mt-4 block max-w-[19ch] text-4xl leading-[1.06] font-medium tracking-[-0.05em] md:text-5xl">
              {HOME.about.titleEmphasis}
            </span>
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-default">{HOME.about.text}</p>
        </div>
        <figure
          class="site-image-motion intersect intersect-once relative isolate min-h-[17rem] overflow-hidden bg-ink lg:col-span-6"
          data-motion-reveal
        >
          <Image
            src={IMAGES.homeHero.src}
            alt={IMAGES.homeHero.alt}
            layout="none"
            widths={[480, 768, 1100]}
            sizes="(min-width: 64rem) 42vw, 100vw"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <PhotoCredit image={IMAGES.homeHero} />
        </figure>
      </div>
      <ol class="mt-12 grid gap-7 md:mt-16 md:grid-cols-3 md:gap-9">
        {
          HOME.about.phases.map(({ title, text }) => (
            <li class="intersect intersect-once border-t border-line pt-5" data-motion-reveal>
              <h3 class="text-xl font-semibold text-heading">{title}</h3>
              <p class="mt-2 max-w-sm text-default">{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <figure
    class="site-image-motion home-satellite intersect intersect-once relative isolate overflow-hidden bg-ink"
    data-motion-reveal
  >
    <Image
      src={IMAGES.orbit.src}
      alt={IMAGES.orbit.alt}
      layout="none"
      widths={[640, 960, 1440, 1920]}
      sizes="100vw"
      class="absolute inset-0 h-full w-full object-cover"
    />
    <PhotoCredit image={IMAGES.orbit} />
  </figure>

  <section class="home-paper py-16 md:py-24" aria-labelledby="why-observing">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <div class="intersect intersect-once grid gap-8 lg:grid-cols-12" data-motion-reveal>
        <h2
          id="why-observing"
          class="scroll-mt-28 text-4xl leading-tight font-medium tracking-[-0.05em] text-heading md:text-5xl lg:col-span-5 lg:pr-8"
        >
          {HOME.whyObserving.title}
        </h2>
        <p class="font-heading text-xl leading-relaxed text-heading md:text-2xl lg:col-span-7">
          {HOME.whyObserving.lead}
        </p>
      </div>
      <ul class="mt-10 grid gap-7 md:grid-cols-3 md:gap-9">
        {
          HOME.whyObserving.reasons.map(({ title, text }) => (
            <li class="intersect intersect-once border-t border-line pt-5" data-motion-reveal>
              <h3 class="text-xl font-semibold text-heading">{title}</h3>
              <p class="mt-3 text-default">{text}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-10 grid gap-6 lg:grid-cols-12">
        <div class="intersect intersect-once lg:col-span-7 lg:col-start-6" data-motion-reveal>
          <p class="text-lg text-default">{HOME.whyObserving.closing}</p>
          <a href={HOME.whyObserving.link.href} class:list={[linkClass, 'mt-5']}>
            {HOME.whyObserving.link.text}
            <Icon name="tabler:arrow-up-right" class="h-4 w-4 shrink-0" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="home-involve py-16 md:py-20" aria-labelledby="shape-next-decade">
    <div class="intersect intersect-once mx-auto grid max-w-7xl gap-8 px-4 lg:grid-cols-12 lg:px-6" data-motion-reveal>
      <h2
        id="shape-next-decade"
        class="scroll-mt-28 text-4xl leading-tight font-medium tracking-[-0.05em] text-white md:text-5xl lg:col-span-5"
      >
        {HOME.shape.title}
      </h2>
      <div class="lg:col-span-7">
        <p class="font-heading text-xl leading-relaxed text-on-dark md:text-2xl">{HOME.shape.text}</p>
        <div class="home-actions mt-8 flex flex-wrap gap-3">
          <a href={getPermalink(HOME.shape.primary.href)} class="btn-site-accent">
            {HOME.shape.primary.text}
            <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
          <a href={getPermalink(HOME.shape.secondary.href)} class="btn-site-outline-light"
            >{HOME.shape.secondary.text}</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Upcoming Events: shared data with News & Events (src/data/events) -->
  <section class="home-paper py-16 md:py-20" aria-labelledby="updates">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="updates"
        title={HOME.events.title}
        link={{ text: HOME.events.link.text, href: getPermalink(HOME.events.link.href) }}
      />
      <div class="mt-8">
        <UpcomingEvents events={upcoming} compact limit={2} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: clamp(38rem, 86svh, 53rem);
    color: white;
    background: var(--aw-color-ink) var(--hero-poster) 77% center / cover no-repeat;
  }

  .home-hero__video,
  .home-hero::before {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-hero__video {
    z-index: -2;
    object-fit: cover;
    object-position: 77% center;
  }

  .home-hero__video:not([data-show-frame]) {
    visibility: hidden;
  }

  .home-hero::before {
    z-index: -1;
    content: '';
    background: linear-gradient(180deg, rgb(7 26 36 / 4%), rgb(7 26 36 / 62%) 40%, rgb(7 26 36 / 82%));
    pointer-events: none;
  }

  .home-hero__copy {
    padding-block: clamp(5rem, 12svh, 8rem) 5.5rem;
    text-shadow: 0 1px 10px rgb(2 11 18 / 85%);
  }

  .home-hero h1 {
    max-width: 18ch;
    font-size: clamp(2.35rem, 6.1vw, 6.4rem);
    font-weight: 450;
    line-height: 1.01;
    letter-spacing: -0.062em;
    text-wrap: balance;
  }

  .home-hero__location {
    margin-bottom: 1.1rem;
    color: #c5e7dd;
    font-weight: 650;
    font-size: 0.85rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .home-actions a {
    border-radius: 0.125rem;
  }

  .home-hero__primary {
    border-color: #8ce6d7;
    background-color: rgb(7 26 36 / 52%);
    text-shadow: none;
  }

  .home-hero__primary:hover {
    background-color: #b4f1e6;
    color: var(--aw-color-ink);
  }

  .home-paper {
    background: #f3f2eb;
  }

  .home-satellite {
    height: clamp(13rem, 25vw, 23rem);
  }

  .home-involve {
    background: #11343c;
  }

  .home-hero__control {
    position: absolute;
    right: 1rem;
    bottom: 0.85rem;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 65%);
    border-radius: 999px;
    background: var(--aw-color-ink);
    cursor: pointer;
  }

  .home-hero__control[hidden],
  .home-hero__control[data-playing] :global([data-play-icon]),
  .home-hero__control:not([data-playing]) :global([data-pause-icon]) {
    display: none;
  }

  .home-hero__control:hover,
  .home-hero__control:focus-visible {
    border-color: var(--aw-color-accent);
  }

  @media (width >= 64rem) {
    .home-hero {
      background-position: center;
    }

    .home-hero__video {
      object-position: center;
    }

    .home-hero::before {
      background:
        linear-gradient(180deg, transparent 30%, rgb(7 26 36 / 45%)),
        linear-gradient(90deg, rgb(7 26 36 / 76%), rgb(7 26 36 / 52%) 67%, rgb(7 26 36 / 5%));
      mask-image: linear-gradient(180deg, rgb(0 0 0 / 24%), #000 38%);
    }

    .home-hero__control {
      right: max(1.5rem, calc((100% - var(--container-7xl)) / 2 + 1.5rem));
    }
  }
</style>
