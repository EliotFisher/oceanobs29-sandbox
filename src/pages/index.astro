---
// Homepage copy and media are read from the shared configuration.
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import SectionHead from '~/components/site/SectionHead.astro';
import UpcomingEvents from '~/components/site/UpcomingEvents.astro';

import { SITE, I18N } from 'astrowind:config';
import { ORG } from '~/config/org';
import { HOME } from '~/config/home';
import Image from '~/components/common/Image.astro';
import PhotoCredit from '~/components/site/PhotoCredit.astro';
import { HERO_VIDEO, IMAGES } from '~/config/images';
import { getImage } from 'astro:assets';
import { getPermalink } from '~/utils/permalinks';
import { getEvents, splitByTime } from '~/utils/events';

const metadata = { title: `${ORG.name}: Shaping the next decade of global ocean observing`, ignoreTitleTemplate: true };

const { upcoming } = splitByTime(await getEvents());
const linkClass = 'inline-flex items-center gap-1.5 font-semibold text-link underline-offset-4 hover:underline';
const heroPoster = await getImage({ src: HERO_VIDEO.poster, width: 1920, format: 'webp' });

// Structured data built only from config.yaml and src/config/org.ts: keep it true.
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${SITE?.site}/#website`,
    name: ORG.name,
    url: SITE?.site,
    inLanguage: I18N?.language,
  },
];
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={structuredData} />

  <section class="home-hero" style={`--hero-poster: url("${heroPoster.src}")`} aria-labelledby="hero-heading">
    <video
      class="home-hero__video"
      poster={heroPoster.src}
      muted
      playsinline
      preload="none"
      tabindex="-1"
      aria-hidden="true"
      data-hero-video
    >
      <source src={HERO_VIDEO.src} type={HERO_VIDEO.type} />
    </video>
    <div class="home-hero__copy mx-auto w-full max-w-7xl px-4 lg:px-6">
      <h1 id="hero-heading">
        <span>{HOME.hero.headlineLead}</span>
        <span>{HOME.hero.headlineEmphasis}</span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-on-dark md:text-xl">{HOME.hero.intro}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={getPermalink(HOME.hero.primary.href)} class="btn-site-accent">
          {HOME.hero.primary.text}
          <Icon name="tabler:arrow-up-right" class="size-4" aria-hidden="true" />
        </a>
        <a href={getPermalink(HOME.hero.secondary.href)} class="btn-site-outline-light">{HOME.hero.secondary.text}</a>
      </div>
    </div>
    <button type="button" class="home-hero__control" data-hero-video-toggle hidden>Pause video</button>
  </section>

  <script>
    function setupHeroVideo() {
      const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
      const button = document.querySelector<HTMLButtonElement>('[data-hero-video-toggle]');
      if (!video || !button || video.dataset.ready) return;
      video.dataset.ready = 'true';

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData;
      if (reduceMotion || saveData) return;

      const update = () => {
        video.toggleAttribute('data-ended', video.ended);
        button.textContent = video.ended ? 'Replay video' : video.paused ? 'Play video' : 'Pause video';
      };

      const play = () => {
        video
          .play()
          .then(() => {
            button.hidden = false;
          })
          .catch(() => {
            // Keep the poster visible when playback is unavailable.
          });
      };

      video.addEventListener('play', update);
      video.addEventListener('pause', update);
      video.addEventListener('ended', update);
      button.addEventListener('click', () => {
        if (video.paused) play();
        else video.pause();
      });

      document.addEventListener('astro:before-swap', () => video.pause(), { once: true });
      play();
    }

    document.addEventListener('astro:page-load', setupHeroVideo);
  </script>

  <!-- 2. About OceanObs, in three short sections. Words in src/config/home.ts. -->
  <section class="py-16 md:py-24" aria-labelledby="about-oceanobs">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <div class="grid items-stretch gap-8 lg:grid-cols-12 lg:gap-14">
        <div class="py-2 lg:col-span-7 lg:py-8">
          <h2 id="about-oceanobs" class="scroll-mt-28 text-heading">
            <span class="eyebrow block text-link">{HOME.about.titleLead}</span>
            <span class="mt-4 block max-w-[19ch] text-4xl leading-[1.04] font-bold tracking-[-0.045em] md:text-5xl">
              {HOME.about.titleEmphasis}
            </span>
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-default">{HOME.about.text}</p>
        </div>
        <figure class="relative isolate min-h-[17rem] overflow-hidden rounded-lg bg-ink lg:col-span-5">
          <Image
            src={IMAGES.homeHero.src}
            alt="Sunlit ocean and clouds over the Philippine Sea, seen from orbit"
            layout="none"
            widths={[480, 768, 1100]}
            sizes="(min-width: 64rem) 42vw, 100vw"
            class="absolute inset-0 h-full w-full object-cover"
          />
          <PhotoCredit image={IMAGES.homeHero} />
        </figure>
      </div>
      <!-- Before / at / after: a connected three-step line (vertical on phones, horizontal from md). -->
      <div class="relative mt-12 md:mt-16">
        <div
          class="absolute top-6 bottom-6 left-6 w-0.5 bg-line md:right-[16.67%] md:bottom-auto md:left-[16.67%] md:h-0.5 md:w-auto"
          aria-hidden="true"
        >
        </div>
        <ol class="relative grid gap-8 md:grid-cols-3 md:gap-6">
          {
            HOME.about.phases.map(({ icon, title, text }, i) => (
              <li class="relative grid grid-cols-[3rem_1fr] gap-x-5 md:grid-cols-1 md:justify-items-center md:text-center">
                <span
                  class:list={[
                    'flex h-12 w-12 items-center justify-center rounded-full ring-8 ring-white',
                    i === 1 ? 'bg-primary text-white' : 'bg-mist text-primary',
                  ]}
                  aria-hidden="true"
                >
                  <Icon name={icon} class="h-6 w-6" />
                </span>
                <div class="md:mt-5">
                  <h3 class="text-xl font-bold text-heading">{title}</h3>
                  <p class="mt-2 text-default md:max-w-xs">{text}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-mist py-16 md:py-24" aria-labelledby="why-observing">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <div class="grid gap-8 lg:grid-cols-12">
        <h2
          id="why-observing"
          class="scroll-mt-28 text-3xl font-bold tracking-tight text-heading md:text-4xl lg:col-span-5 lg:pr-8"
        >
          {HOME.whyObserving.title}
        </h2>
        <p class="font-heading text-xl leading-relaxed text-heading md:text-2xl lg:col-span-7">
          {HOME.whyObserving.lead}
        </p>
      </div>
      <ul class="mt-10 grid gap-4 md:grid-cols-3">
        {
          HOME.whyObserving.reasons.map(({ icon, title, text }) => (
            <li class="rounded-lg border border-line bg-white p-6 md:p-8">
              <Icon name={icon} class="h-9 w-9 text-primary" aria-hidden="true" />
              <h3 class="mt-5 text-xl font-bold text-heading">{title}</h3>
              <p class="mt-3 text-default">{text}</p>
            </li>
          ))
        }
      </ul>
      <div class="mt-10 grid gap-6 lg:grid-cols-12">
        <div class="lg:col-span-7 lg:col-start-6">
          <p class="text-lg text-default">{HOME.whyObserving.closing}</p>
          <a href={HOME.whyObserving.link.href} class:list={[linkClass, 'mt-5']}>
            {HOME.whyObserving.link.text}
            <Icon name="tabler:arrow-up-right" class="h-4 w-4 shrink-0" aria-hidden="true" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="site-dark-band py-16 md:py-24" aria-labelledby="shape-next-decade">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 lg:grid-cols-12 lg:px-6">
      <h2
        id="shape-next-decade"
        class="scroll-mt-28 text-3xl font-bold tracking-tight text-white md:text-5xl lg:col-span-5"
      >
        {HOME.shape.title}
      </h2>
      <div class="lg:col-span-7">
        <p class="font-heading text-xl leading-relaxed text-on-dark md:text-2xl">{HOME.shape.text}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href={getPermalink(HOME.shape.primary.href)} class="btn-site-accent">
            {HOME.shape.primary.text}
            <Icon name="tabler:arrow-right" class="h-4 w-4" aria-hidden="true" />
          </a>
          <a href={getPermalink(HOME.shape.secondary.href)} class="btn-site-outline-light"
            >{HOME.shape.secondary.text}</a
          >
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Upcoming Events: shared data with News & Events (src/data/events) -->
  <section class="py-16 md:py-20" aria-labelledby="updates">
    <div class="mx-auto max-w-7xl px-4 lg:px-6">
      <SectionHead
        id="updates"
        title={HOME.events.title}
        link={{ text: HOME.events.link.text, href: getPermalink(HOME.events.link.href) }}
      />
      <div class="mt-8">
        <UpcomingEvents events={upcoming} compact limit={2} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .home-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: clamp(38rem, 86svh, 59rem);
    color: white;
    background: var(--aw-color-ink) var(--hero-poster) 55% center / cover no-repeat;
  }

  .home-hero__video,
  .home-hero::before {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .home-hero__video {
    z-index: -2;
    object-fit: cover;
    object-position: 55% center;
  }

  .home-hero__video[data-ended] {
    visibility: hidden;
  }

  .home-hero::before {
    z-index: -1;
    content: '';
    background: linear-gradient(180deg, rgb(4 15 29 / 35%), rgb(4 15 29 / 75%) 17%, rgb(4 15 29 / 94%));
  }

  .home-hero__copy {
    padding-block: clamp(5rem, 12svh, 8rem) 5.5rem;
  }

  .home-hero h1 {
    max-width: 15ch;
    font-size: clamp(2.65rem, 6.55vw, 6.75rem);
    font-weight: 750;
    line-height: 0.98;
    letter-spacing: -0.065em;
    text-wrap: balance;
  }

  .home-hero h1 span {
    display: block;
  }

  .home-hero h1 span + span {
    color: var(--aw-color-accent);
  }

  .home-hero__control {
    position: absolute;
    right: 1rem;
    bottom: 0.85rem;
    min-height: 44px;
    padding-inline: 1rem;
    border: 1px solid rgb(255 255 255 / 65%);
    border-radius: 999px;
    background: var(--aw-color-ink) var(--hero-poster) 55% center / cover no-repeat;
    font-size: 0.875rem;
    cursor: pointer;
  }

  .home-hero__control:hover,
  .home-hero__control:focus-visible {
    border-color: var(--aw-color-accent);
  }

  @media (width >= 64rem) {
    .home-hero::before {
      background:
        linear-gradient(180deg, rgb(4 15 29 / 20%), transparent 25%, rgb(4 15 29 / 78%)),
        linear-gradient(90deg, rgb(4 15 29 / 90%), rgb(4 15 29 / 75%) 63%, transparent);
    }

    .home-hero__control {
      right: max(1.5rem, calc((100% - var(--container-7xl)) / 2 + 1.5rem));
    }
  }
</style>
