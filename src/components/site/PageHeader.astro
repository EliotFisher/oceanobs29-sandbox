---
// Dark page header for inner pages: H1 and intro (the eyebrow label was removed 2026-11-22), with an optional
// full-bleed photo behind (same treatment as the homepage hero, smaller).
import Image from '~/components/common/Image.astro';
import PhotoCredit from '~/components/site/PhotoCredit.astro';
import type { SiteImage } from '~/config/images';

export interface Props {
  title: string;
  intro?: string;
  image?: SiteImage;
}

const { title, intro, image } = Astro.props;
---

<section class="site-dark-band relative isolate overflow-hidden" aria-labelledby="page-heading">
  {
    image && (
      <>
        <Image
          src={image.src}
          alt={image.alt}
          layout="none"
          loading="eager"
          widths={[768, 1280, 1920]}
          sizes="100vw"
          style={image.position ? `object-position: ${image.position}` : undefined}
          class="absolute inset-0 -z-10 h-full w-full object-cover"
        />
        <div class="absolute inset-0 -z-10 bg-ink/80" aria-hidden="true" />
        <PhotoCredit image={image} />
      </>
    )
  }
  <div class="mx-auto max-w-7xl px-4 pt-16 pb-16 md:pt-24 md:pb-24 lg:px-6">
    <h1
      id="page-heading"
      class="max-w-5xl text-[clamp(2.5rem,6.5vw,6rem)] leading-[0.98] font-bold tracking-[-0.06em] text-white [overflow-wrap:anywhere]"
    >
      {title}
    </h1>
    {intro && <p class="mt-6 max-w-2xl text-lg text-on-dark md:text-xl">{intro}</p>}
    <slot />
  </div>
</section>
