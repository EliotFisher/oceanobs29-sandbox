---
// OceanObs’29 wordmark (PNG from the old site until an SVG is available).
import Image from '~/components/common/Image.astro';
import logoColor from '~/assets/images/site/logo-oceanobs29-color.png';
import logoWhite from '~/assets/images/site/logo-oceanobs29-white.png';
import { ORG } from '~/config/org';

interface Props {
  light?: boolean;
}

const { light = false } = Astro.props;
const logo = light ? logoWhite : logoColor;
---

<Image src={logo} alt={ORG.name} layout="none" width={180} class="h-9 w-auto self-center md:h-10" loading="eager" />
